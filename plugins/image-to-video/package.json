{
  "name": "@pruna-ai/image-to-video",
  "version": "1.0.5",
  "type": "module",
  "license": "MIT",
  "description": "Use when someone wants one short film beat from images \u2014 a narrated scene, story moment, or cinematic B-roll with optional voiceover.",
  "repository": "https://github.com/PrunaAI/pruna-skills",
  "files": [
    ".claude-plugin",
    "openclaw.plugin.json",
    "openclaw-entry.mjs",
    "README.md",
    "skills"
  ],
  "openclaw": {
    "extensions": [
      "./openclaw-entry.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "bundledSkills": [
      "image-to-video",
      "p-image",
      "p-image-edit",
      "p-video",
      "gemini-3.1-flash-tts",
      "stable-audio-2.5"
    ]
  }
}
