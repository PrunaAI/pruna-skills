  "registries": {
    "github": {
      "method": "git tag + push",
      "tag": "skills-v0.0.2",
      "note": "No upload API \u2014 consumers install from GitHub paths after push"
    },
    "npx": {
      "method": "npx skills add (GitHub source)",
      "listAll": "npx skills add PrunaAI/pruna-skills -l",
      "installSkill": "npx skills add PrunaAI/pruna-skills/plugins/<name>/skills --skill <name> -y",
      "installPluginSkills": "npx skills add PrunaAI/pruna-skills/plugins/<name>/skills --skill <name> -y",
      "skillsSh": "https://skills.sh \u2014 listing via install telemetry after first install"
    },
    "clawhubSkills": {
      "method": "clawhub skill publish",
      "owner": "PrunaAI",
      "install": "clawhub install @PrunaAI/<slug>",
      "publish": "./scripts/publish_all_skills.sh --execute --target clawhub"
    },
    "clawhubPlugins": {
      "method": "clawhub package publish --family bundle-plugin",
      "owner": "PrunaAI",
      "install": "openclaw plugins install clawhub:@PrunaAI/<name>",
      "publish": "./scripts/publish_all_skills.sh --execute --target clawhub-plugins"
    },
    "claude": {
      "method": "plugin marketplace in repo",
      "install": "/plugin install <name>@pruna-skills"
    },
    "apm": {
      "method": "git install",
      "install": "apm install PrunaAI/pruna-skills/plugins/<name>/skills/<name>"
    }
  }
}
