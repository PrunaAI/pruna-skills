{
  "scripts": {
    "core": ["run_from_plan.py", "assemble_slideshow.py"],
    "shared": [
      "generation_gate.py",
      "launch_background_music.py",
      "pruna_api.py",
      "replicate_api.py",
      "stills_pipeline.py",
      "requirements.txt"
    ],
    "optional": []
  },
  "tool_skills": [
    "p-image",
    "p-image-edit",
    "gemini-3.1-flash-tts",
    "stable-audio-2.5"
  ],
  "references": [
    "illustrated-story-reel-prompts.md",
    "illustrated-story-reel-gates.md",
    "illustrated-story-reel-api.md",
    "illustrated-story-reel-quality.md",
    "api-credentials.md",
    "generation-diversity.md",
    "random-seed-ritual.md",
    "p-image-quality-checklist.md",
    "p-image-edit-quality-checklist.md"
  ],
  "permissions": {
    "capabilities": ["network", "subprocess", "filesystem"],
    "network": {
      "domains": ["api.pruna.ai", "api.replicate.com"]
    },
    "env": ["PRUNA_API_KEY", "REPLICATE_API_TOKEN"],
    "executables": ["python3", "ffmpeg", "ffprobe"],
    "filesystem": {
      "read": ["user media paths referenced in plan.json"],
      "write": ["--out-dir output tree (stills, audio, segments, mp4)"]
    },
    "rationale": {
      "network": "p-image/p-image-edit via Pruna; TTS and music via Replicate",
      "subprocess": "ffmpeg/ffprobe Ken Burns assembly and audio mux",
      "filesystem": "Read plan and optional user music track; write generated media under out-dir"
    }
  },
  "templates": ["story-plan.template.json", "story-plan.landscape.template.json"],
  "generation_phases": {
    "default": "stills",
    "phases": ["stills", "tts", "music", "assemble"],
    "gates": {
      "tts": {
        "requires": "phase_a_approved",
        "approve_flag": "--approve-stills",
        "skip_flag": "--yes-skip-stills-gate"
      },
      "music": {
        "requires": "phase_a_approved",
        "approve_flag": "--approve-stills",
        "skip_flag": "--yes-skip-stills-gate"
      },
      "assemble": {
        "requires": "phase_b_approved",
        "approve_flag": "--approve-audio",
        "skip_flag": "--yes-skip-clips-gate"
      }
    },
    "requires_user_approval_before": ["p-image-edit", "gemini-3.1-flash-tts", "stable-audio-2.5"]
  },
  "generation_package": ["script"]
}
