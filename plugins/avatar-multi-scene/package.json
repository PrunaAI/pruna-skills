{
  "name": "@pruna-ai/avatar-multi-scene",
  "version": "1.0.4",
  "type": "module",
  "license": "MIT",
  "description": "Use when someone wants the same person hosting several clips \u2014 multi-segment UGC, comparison reels, or mixed speaking and animated scenes with continuity.",
  "repository": "https://github.com/PrunaAI/pruna-skills",
  "files": [
    ".claude-plugin",
    "openclaw.plugin.json",
    "openclaw-entry.mjs",
    "README.md",
    "skills"
  ],
  "openclaw": {
    "extensions": [
      "./openclaw-entry.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "bundledSkills": [
      "avatar-multi-scene",
      "p-image",
      "p-image-edit",
      "p-video-avatar",
      "p-video-animate"
    ]
  }
}
