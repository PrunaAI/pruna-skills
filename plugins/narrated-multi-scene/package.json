  "files": [
    ".claude-plugin",
    "openclaw.plugin.json",
    "openclaw-entry.mjs",
    "README.md",
    "skills"
  ],
  "openclaw": {
    "extensions": [
      "./openclaw-entry.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "bundledSkills": [
      "narrated-multi-scene",
      "p-image",
      "p-image-edit",
      "p-video",
      "gemini-3.1-flash-tts",
      "stable-audio-2.5"
    ]
  }
}
