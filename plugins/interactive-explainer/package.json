{
  "name": "@pruna-ai/interactive-explainer",
  "version": "1.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Use when the user wants educational explainers with a host plus in-story characters, history or science shorts, or witness and expert dialogue\u2014not wall-to-wall narration alone.",
  "repository": "https://github.com/PrunaAI/pruna-skills",
  "files": [
    ".claude-plugin",
    "openclaw.plugin.json",
    "openclaw-entry.mjs",
    "README.md",
    "skills"
  ],
  "openclaw": {
    "extensions": [
      "./openclaw-entry.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "bundledSkills": [
      "interactive-explainer",
      "p-image",
      "p-image-edit",
      "p-video",
      "p-video-avatar",
      "gemini-3.1-flash-tts",
      "stable-audio-2.5"
    ]
  }
}
