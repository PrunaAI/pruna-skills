{
  "scripts": {
    "core": ["run_from_plan.py"],
    "shared": [
      "concat_clips.py",
      "generation_gate.py",
      "launch_background_music.py",
      "p_video_payload.py",
      "plan_runner.py",
      "pruna_api.py",
      "replicate_api.py",
      "stills_pipeline.py",
      "requirements.txt"
    ],
    "optional": []
  },
  "tool_skills": ["p-image", "p-image-edit", "p-video", "stable-audio-2.5"],
  "references": [
    "scene-anchor-pair.md",
    "pruna-api.md",
    "staged-generation-gate.md",
    "workflow-feedback-gates.md",
    "parallel-execution.md",
    "generation-quality-checklists.md",
    "p-video-quality-checklist.md"
  ],
  "templates": ["transition-plan.template.json"],
  "generation_phases": {
    "default": "stills",
    "phases": ["stills", "video", "assemble"],
    "gates": {
      "video": {
        "requires": "phase_a_approved",
        "approve_flag": "--approve-stills",
        "skip_flag": "--yes-skip-stills-gate"
      },
      "assemble": {
        "requires": "phase_b_approved",
        "approve_flag": "--approve-clips",
        "skip_flag": "--yes-skip-clips-gate"
      }
    },
    "requires_user_approval_before": ["p-video"]
  },
  "generation_package": ["script"]
}
