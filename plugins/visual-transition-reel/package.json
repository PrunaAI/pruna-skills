{
  "name": "@pruna-ai/visual-transition-reel",
  "version": "1.0.2",
  "type": "module",
  "license": "MIT",
  "description": "Use when the user needs a visual montage, transitions between stills, action-sequence reel, or multi-scene piece where narration is optional or absent.",
  "repository": "https://github.com/PrunaAI/pruna-skills",
  "files": [
    ".claude-plugin",
    "openclaw.plugin.json",
    "openclaw-entry.mjs",
    "README.md",
    "skills"
  ],
  "openclaw": {
    "extensions": [
      "./openclaw-entry.mjs"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2"
    },
    "bundledSkills": [
      "visual-transition-reel",
      "p-image",
      "p-image-edit",
      "p-video",
      "stable-audio-2.5"
    ]
  }
}
