{
  "version": "0.0.1",
  "package": "pruna-ai-content-generation-skills",
  "repository": "https://github.com/PrunaAI/pruna-ai-content-generation-skills",
  "skillsPath": "skills",
  "gitTag": "skills-v0.0.1",
  "skills": [
    "avatar-multi-scene",
    "avatar-single-scene",
    "gemini-3.1-flash-tts",
    "illustrated-story-reel",
    "image-to-video",
    "interactive-explainer",
    "music-2.5",
    "music-video",
    "narrated-multi-scene",
    "p-image",
    "p-image-edit",
    "p-image-try-on",
    "p-image-upscale",
    "p-video",
    "p-video-animate",
    "p-video-avatar",
    "p-video-replace",
    "pruna-generative-pipeline",
    "pruna-run",
    "requesting-generation-feedback",
    "stable-audio-2.5",
    "visual-transition-reel",
    "whisperx"
  ],
  "registries": {
    "github": {
      "method": "git tag + push",
      "tag": "skills-v0.0.1",
      "install": "npx skills add PrunaAI/pruna-ai-content-generation-skills/skills --skill <name>"
    },
    "skills.sh": {
      "method": "install telemetry (no upload API)",
      "note": "Listing follows npx skills add usage"
    },
    "apm": {
      "method": "git install (no per-skill registry upload)",
      "install": "apm install PrunaAI/pruna-ai-content-generation-skills/skills/<name>"
    },
    "pspm": {
      "method": "pspm publish",
      "package": "@pruna/<name>",
      "requires": [
        "PSPM_API_KEY"
      ]
    }
  }
}
