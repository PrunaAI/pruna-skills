{
  "scripts": {
    "core": ["run_from_plan.py", "generate_tryon_showcase.py"],
    "shared": [
      "generation_gate.py",
      "pruna_paths.py",
      "pruna_api.py",
      "replicate_api.py",
      "launch_background_music.py",
      "concat_clips.py",
      "requirements.txt"
    ],
    "optional": [],
    "repo_only": []
  },
  "tool_skills": [
    "p-image",
    "p-image-try-on",
    "p-video-avatar",
    "gemini-3.1-flash-tts",
    "stable-audio-2.5"
  ],
  "references": [
    "pruna-api.md",
    "replicate-api.md",
    "staged-generation-gate.md",
    "workflow-feedback-gates.md",
    "visual-variety-bible.md",
    "p-image-try-on-quality-checklist.md",
    "parallel-execution.md",
    "generation-quality-checklists.md"
  ],
  "templates": [
    "scene-plan.template.json",
    "curl-phase-a.template.sh",
    "curl-phase-b.template.sh"
  ],
  "generation_phases": {
    "default": "stills",
    "phases": ["stills", "video", "tts", "assemble"],
    "gates": {
      "video": {
        "requires": "phase_a_approved",
        "approve_flag": "--approve-stills",
        "skip_flag": "--yes-skip-stills-gate"
      },
      "tts": {
        "requires": "phase_a_approved",
        "approve_flag": "--approve-stills",
        "skip_flag": "--yes-skip-stills-gate"
      },
      "assemble": {
        "requires": "phase_b_approved",
        "approve_flag": "--approve-audio",
        "skip_flag": "--yes-skip-clips-gate"
      }
    },
    "requires_user_approval_before": ["p-image-try-on", "p-video", "p-video-avatar"]
  },
  "generation_package": ["curl", "script"]
}
