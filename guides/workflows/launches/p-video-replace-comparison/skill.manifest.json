{
  "scripts": {
    "core": ["run_from_plan.py"],
    "shared": [
      "generation_gate.py",
      "plan_runner.py",
      "pruna_paths.py",
      "pruna_api.py",
      "replicate_api.py",
      "launch_background_music.py",
      "generate_video_comparison.py",
      "requirements.txt"
    ],
    "optional": [],
    "repo_only": []
  },
  "tool_skills": [
    "p-image",
    "p-image-edit",
    "p-video-avatar",
    "p-video-replace",
    "stable-audio-2.5"
  ],
  "references": [
    "pruna-api.md",
    "replicate-api.md",
    "staged-generation-gate.md",
    "workflow-feedback-gates.md",
    "visual-variety-bible.md",
    "p-video-replace-quality-checklist.md",
    "parallel-execution.md",
    "generation-quality-checklists.md"
  ],
  "templates": [
    "scene-plan.template.json",
    "config.template.json",
    "config.multi-sample.template.json",
    "batch.template.json",
    "curl-phase-a.template.sh",
    "curl-phase-b.template.sh"
  ],
  "generation_phases": {
    "default": "stills",
    "phases": ["stills", "video", "render"],
    "gates": {
      "video": {
        "requires": "phase_a_approved",
        "approve_flag": "--approve-stills",
        "skip_flag": "--yes-skip-stills-gate"
      },
      "render": {
        "requires": "phase_b_approved",
        "approve_flag": "--approve-clips",
        "skip_flag": "--yes-skip-clips-gate"
      }
    },
    "requires_user_approval_before": ["p-video-avatar", "p-video-replace"]
  },
  "generation_package": ["curl", "script"]
}
